{
  "name": "ossfit",
  "version": "0.1.0",
  "description": "Better GitHub discovery — repos ranked by fit, health, and underrated potential.",
  "type": "module",
  "bin": {
    "ossfit": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/cli/index.js"
  },
  "dependencies": {
    "@hono/node-server": "2.1.8",
    "@huggingface/transformers": "4.3.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-sqlite3": "13.2.0",
    "commander": "15.1.0",
    "hono": "4.13.18"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true,
    "onnxruntime-node@1.30.0": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "fsevents@2.3.3": true
  }
}
